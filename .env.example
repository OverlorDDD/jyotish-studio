# Copy to .env and set secrets ONLY locally. Do not commit .env!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The default mode is FREE. Even an old OPENAI_ENABLED=1 cannot trigger paid calls
# unless AI_MODE=paid_openai is explicitly selected (NOT recommended).
AI_MODE=free
# Zero-token-price OpenRouter router (API key from https://openrouter.ai/keys).
OPENROUTER_API_KEY=
FREE_AI_ORDER=openrouter,ollama
FREE_AI_MAX_CALLS_PER_HOUR=10
# Optional offline local fallback, installed separately: ollama pull gemma3:1b
OLLAMA_ENABLED=0
OLLAMA_MODEL=gemma3:1b
# Legacy paid OpenAI opt-in, unused when AI_MODE=free:
# API calls are OFF by default to avoid accidental billing.
OPENAI_ENABLED=0
OPENAI_MAX_CALLS_PER_HOUR=5
# Before ngrok, choose private demo login credentials (unique 14+ char ASCII password).
DEMO_ACCESS_USER=
DEMO_ACCESS_PASSWORD=
DATABASE_URL=postgresql://jyotish:jyotish_dev@localhost:5433/jyotish?schema=public
PORT=4000
# The Next.js browser calls /api through the same-origin proxy. No public API URL is required.
# Set to 1 to enable a portable Python/PySwissEph fallback if npm native binding is absent.
ALLOW_PYTHON_SWISSEPH=1
