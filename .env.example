# Copy to .env and set secrets ONLY locally. Do not commit .env!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The default mode is FREE. Even an old OPENAI_ENABLED=1 cannot trigger paid calls
# unless AI_MODE=paid_openai is explicitly selected (NOT recommended).
AI_MODE=free
# Zero-token-price OpenRouter router (API key from https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Optional: choose a verified no-cost :free model instead of random openrouter/free.
# CAUTION: some historic :free slugs (including qwen/qwen3-32b:free) have no live endpoints.
# Leave blank to use openrouter/free, or select an ACTIVE listed free model via npm run ai:doctor.
OPENROUTER_FREE_MODEL=
# Jyotish reports use ONLINE cloud providers only by default (no Ollama).
FREE_AI_ORDER=gemini,groq,openrouter
# Optional independent Google AI Studio account on its FREE tier only.
# First verify billing is DISABLED and the selected model has a free allotment.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=0
# Stable free-tier model: gemini-3.1-flash-lite; gemini-2.5-flash-lite retired on 2026-10-16.
# The adapter pins the free model; model selection cannot silently turn on paid calls.
# Independent GroqCloud API: create a FREE plan with no billing, check limits.
# Never enable on a paid Groq account unless separately implementing paid mode.
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=0
# Explicit allowlist prevents accidentally targeting unapproved paid models.
GROQ_MODEL=openai/gpt-oss-120b
FREE_AI_MAX_CALLS_PER_HOUR=10
# Local model disabled for this cloud-only deployment.
OLLAMA_ENABLED=0
# Legacy paid OpenAI opt-in, unused when AI_MODE=free:
# API calls are OFF by default to avoid accidental billing.
OPENAI_ENABLED=0
OPENAI_MAX_CALLS_PER_HOUR=5
# Single public site: guests use all calculations/readings without saving.
# Registered accounts need a unique 32+ character secret to sign HttpOnly sessions.
# Generate in PowerShell: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional for temporary public links: discourage indexing by search engines.
SITE_NOINDEX=1
DATABASE_URL=postgresql://jyotish:jyotish_dev@localhost:5433/jyotish?schema=public
PORT=4000
WEB_PORT=3000
# Internal server-only Next.js API proxy; never sent to visitors.
INTERNAL_API_ORIGIN=http://127.0.0.1:4000
# The Next.js browser calls /api through the same-origin proxy. No public API URL is required.
# Set to 1 to enable a portable Python/PySwissEph fallback if npm native binding is absent.
ALLOW_PYTHON_SWISSEPH=1

# GalaxiNews: automatic 15-minute RSS/GDELT scan. Existing local .env files
# need this flag for production; local src/main.ts also safely defaults on.
NEWS_INGESTION_ENABLED=1
# AI-written UA/EN teasers require an explicitly configured free provider above.
NEWS_EDITORIAL_AI_ENABLED=1
# Article photographs are displayed ONLY with granted licensing or approved
# publisher-host permission; first-party illustrations cover other stories.
# NEWS_IMAGE_ALLOWED_HOSTS=publisher-with-explicit-reuse-rights.example
# WORLDWIDE CITY SEARCH: Open-Meteo Geocoding non-commercial free tier;
# obtain commercial subscription/provider before monetizing this endpoint.
# A1: optional strict secure session cookies on HTTPS public deployments.
# Leave unset for localhost HTTP. Use SESSION_COOKIE_SECURE=1 only when accessed via HTTPS.
SESSION_COOKIE_SECURE=0
# Galaxiora Tarot v2: opt-in vivid AI narrative. OFF by default (no paid calls).
# Turn on only after selecting a provider and setting a key/budget.
TAROT_AI_ENABLED=false
TAROT_AI_PROVIDER=openai
TAROT_AI_MODEL=gpt-4.1-mini
# OpenRouter: set TAROT_AI_PROVIDER=openrouter and OPENROUTER_API_KEY above.
# Ollama: set TAROT_AI_PROVIDER=ollama and install/pull TAROT_AI_MODEL locally.
# Human-style offline text remains available without any AI key.
# Optional: images use local files (recommended). Execute npm run tarot:assets once.

# A4 launch: set ONLY after obtaining a stable HTTPS domain you control.
# Example: NEXT_PUBLIC_SITE_URL=
# Optional verification token generated in your Google Search Console property.
GOOGLE_SITE_VERIFICATION=
# Enable indexing ONLY on your owned, stable HTTPS domain and after launch:verify PASS.
# SITE_NOINDEX=0  (leave SITE_NOINDEX=1 for ngrok / temporary previews)https://your-domain.example
# Keep SITE_NOINDEX=1 on temporary URLs. Public indexing requires this valid HTTPS origin AND SITE_NOINDEX=0.
NEXT_PUBLIC_SITE_URL=

# Optional request metrics without URL/cookie/personal text. Off by default.
HTTP_ACCESS_LOG=0
