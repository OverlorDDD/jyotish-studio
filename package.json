{
  "name": "jyotish-studio",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types apps/api/src/standalone.ts",
    "dev:api": "npm run start:dev -w @jyotish/api",
    "dev:web": "npm run dev -w @jyotish/web",
    "dev:full": "npx concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "test": "node --experimental-strip-types --test packages/jyotish-core/src/*.test.ts",
    "build": "npm run build -w @jyotish/core && npm run build -w @jyotish/api && npm run build -w @jyotish/web",
    "db:generate": "node --env-file=.env ./node_modules/prisma/build/index.js generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env ./node_modules/prisma/build/index.js migrate deploy --schema=apps/api/prisma/schema.prisma",
    "test:reference": "node --experimental-strip-types tools/reference-check.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:reference",
    "test:full": "node tools/smoke-test.mjs",
    "test:ui": "node --test tools/chart-labels.test.mjs",
    "preflight:full": "node tools/fullstack-preflight.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3"
  }
}
