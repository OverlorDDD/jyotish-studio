{
  "name": "jyotish-studio",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types apps/api/src/standalone.ts",
    "dev:api": "npm run start:dev -w @jyotish/api",
    "dev:web": "npm run dev -w @jyotish/web",
    "dev:full": "npx concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "test": "node --experimental-strip-types --test packages/jyotish-core/src/*.test.ts",
    "build": "npm run build -w @jyotish/core && npm run build -w @jyotish/api && npm run build -w @jyotish/web",
    "db:generate": "node --env-file=.env ./node_modules/prisma/build/index.js generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env ./node_modules/prisma/build/index.js migrate deploy --schema=apps/api/prisma/schema.prisma",
    "test:reference": "node --experimental-strip-types tools/reference-check.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:reference && npm run test:ai && npm run test:api-response && npm run test:access && npm run test:free-ai && npm run test:free-ai-retry && npm run test:report && npm run test:terminology && npm run test:engine2 && npm run test:portal && npm run test:platform && npm run test:stage3 && npm run test:tarot && npm run test:brand && npm run test:tarot:depth && npm run test:tarot:v2 && npm run test:tarot:session",
    "test:full": "node tools/smoke-test.mjs --require-nest",
    "test:ui": "node --test tools/chart-labels.test.mjs",
    "preflight:full": "node tools/fullstack-preflight.mjs",
    "test:swagger": "npm run test:swagger -w @jyotish/api",
    "test:ai": "node --experimental-strip-types --test tools/ai-interpretation.test.mjs",
    "test:demo": "npm run test:access",
    "demo:check": "npm run site:check",
    "start:full": "npx concurrently -k \"npm run start -w @jyotish/api\" \"npm run start -w @jyotish/web\"",
    "openai:check": "node --env-file=.env tools/openai-diagnose.mjs",
    "test:free-ai": "node --experimental-strip-types --test tools/free-ai.test.mjs",
    "free-ai:check": "node --env-file=.env tools/free-ai-check.mjs",
    "test:api-response": "node --experimental-strip-types --test tools/api-response.test.mjs",
    "test:free-ai-retry": "node --experimental-strip-types --test tools/free-ai-retry.test.mjs",
    "test:report": "node --experimental-strip-types --test tools/detailed-report.test.mjs",
    "test:terminology": "node --experimental-strip-types --test tools/terminology.test.mjs",
    "test:access": "node --experimental-strip-types --test tools/account-access.test.mjs",
    "site:check": "node --env-file=.env tools/site-preflight.mjs",
    "test:engine2": "node --experimental-strip-types --test tools/engine2.test.mjs tools/interpretation-policy.test.mjs",
    "dev:public": "node tools/public-launch.mjs",
    "test:portal": "node --test tools/portal-stage1.test.mjs",
    "test:platform": "node --test tools/platform-stage2.test.mjs",
    "test:stage3": "node --test tools/platform-stage3.test.mjs",
    "db:doctor": "node tools/db-doctor.mjs",
    "db:prune-drafts": "node --env-file=.env tools/prune-expired-reading-drafts.mjs",
    "admin:setup": "node --env-file=.env tools/setup-owner.mjs",
    "test:tarot": "node --experimental-strip-types --test tools/tarot-roles.test.mjs",
    "test:brand": "node --test tools/galaxiora-branding.test.mjs",
    "test:tarot:depth": "node --experimental-strip-types --test tools/tarot-depth-nav.test.mjs",
    "tarot:assets": "node tools/tarot-assets.mjs",
    "test:tarot:v2": "node --experimental-strip-types --test tools/tarot-v2.test.mjs",
    "predev:full": "node --experimental-strip-types tools/tarot-assets-prepare.mjs",
    "tarot:verify-art": "node --experimental-strip-types tools/tarot-assets-prepare.mjs",
    "test:tarot:session": "node --test tools/tarot-v2-session.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3"
  }
}
