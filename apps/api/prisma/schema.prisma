generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

/** Staff permissions are independent from paid membership. */
enum SubscriptionTier {
 FREE
 PREMIUM
}

enum UserRole {
 MEMBER
 EXPERT
 SUPPORT
 ADMIN
}

enum ReadingOrderStatus {
 AWAITING_PAYMENT
 PAID
 BRIEF_SUBMITTED
 ASSIGNED
 IN_PROGRESS
 VIDEO_READY
 COMPLETED
 CANCELLED
 REFUNDED
}

model User {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 email String @unique
 passwordHash String
 role UserRole @default(MEMBER)
 subscriptionTier SubscriptionTier @default(FREE)
 subscriptionEndsAt DateTime?
 readingDrafts ReadingDraft[]
 tarotReadings TarotReading[]
 expertProfile ExpertProfile?
 roleChangesAsTarget RoleChange[] @relation("RoleChangeTarget")
 roleChangesAsActor RoleChange[] @relation("RoleChangeActor")
 charts Chart[]
 readingOrders ReadingOrder[] @relation("OrderCustomer")
 expertOrders ReadingOrder[] @relation("OrderExpert")
}

model Chart {
 id         String   @id @default(uuid())
 ownerId    String?
 owner      User? @relation(fields:[ownerId],references:[id],onDelete:Cascade)
 savedReport Json?
 createdAt  DateTime @default(now())
 input      Json
 result     Json
 readings   Interpretation[]
 @@index([ownerId])
}
model Interpretation {
 id         String @id @default(uuid())
 createdAt  DateTime @default(now())
 chartId    String
 chart      Chart @relation(fields: [chartId],references: [id],onDelete:Cascade)
 provider   String
 language   String
 text       String @db.Text
 @@index([chartId])
}

/// Only server-side verified payment webhooks may transition AWAITING_PAYMENT to PAID.
/// Reader access to orders and fulfilment must be gated on verified payment.
model ReadingOrder {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 customerId String
 customer User @relation("OrderCustomer",fields:[customerId],references:[id])
 expertId String?
 expert User? @relation("OrderExpert",fields:[expertId],references:[id])
 status ReadingOrderStatus @default(AWAITING_PAYMENT)
 offerCode String
 currency String
 amountMinor Int
 paymentProvider String?
 providerPaymentId String? @unique
 paymentVerifiedAt DateTime?
 question String? @db.Text
 context String? @db.Text
 deliveryFileKey String?
 completedAt DateTime?
 @@index([customerId,createdAt])
 @@index([expertId,status])
 @@index([status,createdAt])
}

model AiUsage {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 provider String
 model String
 operation String
 outcome String
 promptTokens Int?
 completionTokens Int?
 totalTokens Int?
 costUsd Float?
 @@index([createdAt])
 @@index([provider,model,createdAt])
}

/** Private pre-checkout brief. Visible to its author only; not an expert order.
 * Payment provider integration will create a real order in a verified server flow.
 * Drafts can be deleted by author, expire after 7 days and require scheduled pruning.
 */
model ReadingDraft {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 expiresAt DateTime
 customerId String
 customer User @relation(fields:[customerId],references:[id],onDelete:Cascade)
 topic String
 question String @db.Text
 context String @db.Text
 timeframe String? @db.VarChar(140)
 consentAt DateTime
 @@index([customerId,createdAt])
 @@index([expiresAt])
}

/** Audit trail of permissions changed through authenticated admin API. */
model RoleChange {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 actorId String
 actor User @relation("RoleChangeActor",fields:[actorId],references:[id],onDelete:Restrict)
 targetId String
 target User @relation("RoleChangeTarget",fields:[targetId],references:[id],onDelete:Restrict)
 previousRole UserRole
 newRole UserRole
 @@index([createdAt])
 @@index([targetId,createdAt])
}

/** Each confirmed free draw counts against user's 3-per-UTC-day quota. */
model TarotReading {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 spread String
 question String? @db.VarChar(600)
 cards Json
 deckVersion String @default("rws-v1")
 aiTextUk String? @db.Text
 aiTextEn String? @db.Text
 @@index([userId,createdAt])
}


/// Real practitioners only. An ADMIN verifies actual EXPERT role and chooses when to publish.
model ExpertProfile {
 id String @id @default(uuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 displayName String @db.VarChar(90)
 bioUk String @db.Text
 bioEn String @db.Text
 isPublished Boolean @default(false)
 createdAt DateTime @default(now())
 offers ExpertOffering[]
 @@index([isPublished])
}

/// An advertised service, not an order or a charge. Checkout is disabled.
model ExpertOffering {
 id String @id @default(uuid())
 expertId String
 expert ExpertProfile @relation(fields:[expertId],references:[id],onDelete:Cascade)
 titleUk String @db.VarChar(130)
 titleEn String @db.VarChar(130)
 descriptionUk String @db.Text
 descriptionEn String @db.Text
 priceMinor Int
 currency String @default("USD") @db.VarChar(3)
 deliveryDays Int @default(5)
 isPublished Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([expertId,isPublished])
}
